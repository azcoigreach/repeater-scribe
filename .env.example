ASLT_HOST_ARCHIVE_PATH=./asl-monitor
ASL3_NETWORK_NAME=asl3-docker_default
ASLT_APP_ENV=production
ASLT_APP_NAME=repeater-scribe
ASLT_LOG_LEVEL=INFO
ASLT_DATABASE_URL=sqlite:////data/asl_transcriber.db
ASLT_DATA_DIR=/data
ASLT_TMP_DIR=/tmp
ASLT_SOURCE_TIMEZONE=UTC
ASLT_ARCHIVE_PATHS=/audio
ASLT_CORRELATION_TOLERANCE_SECONDS=30
# Local faster-whisper final pass (12 GB NVIDIA profile)
ASLT_WHISPER_MODEL=large-v3
ASLT_WHISPER_DEVICE=cuda
ASLT_WHISPER_COMPUTE_TYPE=float16
ASLT_WHISPER_MODEL_DIR=/data/models/whisper
ASLT_WHISPER_LANGUAGE=en
ASLT_WHISPER_BEAM_SIZE=5
ASLT_WHISPER_VAD_FILTER=true
# Leave prompts empty unless a real-audio A/B test proves they help.
ASLT_WHISPER_INITIAL_PROMPT=
ASLT_WHISPER_HOTWORDS=
# Post-decode callsign context; add your own comma-separated callsigns.
ASLT_KNOWN_CALLSIGNS=
ASLT_CALLSIGN_HOTWORD_LIMIT=0
ASLT_CALLSIGN_MAX_CANDIDATES=250
ASLT_CALLSIGN_CONTEXT_CACHE_SECONDS=30
# Optional QRZ XML Logbook Data account. Credentials stay on the server.
ASLT_QRZ_USERNAME=
ASLT_QRZ_PASSWORD=
# Prefer ASLT_QRZ_PASSWORD_FILE=/run/secrets/qrz_password in internet deployments.
ASLT_QRZ_PASSWORD_FILE=
ASLT_QRZ_BASE_URL=https://xmldata.qrz.com/xml/current/
ASLT_QRZ_TIMEOUT_SECONDS=10
ASLT_QRZ_CACHE_SECONDS=86400
ASLT_QRZ_LAST_HEARD_LIMIT=25
ASLT_WORKER_CONCURRENCY=1
ASLT_ARCHIVE_POLL_SECONDS=1
ASLT_AUTO_PROCESS=true
# Provisional archive-tail pass; the stable WAV always gets a full final pass.
ASLT_LIVE_TRANSCRIPTION=true
ASLT_LIVE_POLL_SECONDS=1.5
ASLT_LIVE_WINDOW_SECONDS=12
ASLT_LIVE_BEAM_SIZE=1
ASLT_LIVE_MIN_FILE_BYTES=4096
ASLT_LIVE_MAX_FILES_PER_CYCLE=1
ASLT_FFMPEG_BINARY=ffmpeg
ASLT_FILE_STABILIZATION_SECONDS=5
ASLT_DEPLOYMENT_MODE=local
ASLT_AUTH_MODE=off
# Internet mode requires an exact HTTPS public URL, explicit host allowlist,
# a 32+ character session secret, and OIDC configuration.
ASLT_PUBLIC_HOST=repeater.example.com
ASLT_CORS_ORIGINS=
ASLT_PUBLIC_BASE_URL=http://localhost:8088
ASLT_ALLOWED_HOSTS=localhost,127.0.0.1
ASLT_SESSION_SECRET=
ASLT_SESSION_SECRET_FILE=
ASLT_SESSION_COOKIE_NAME=__Host-aslt_session
ASLT_SESSION_IDLE_SECONDS=3600
ASLT_SESSION_ABSOLUTE_SECONDS=28800
ASLT_OIDC_ISSUER_URL=
ASLT_OIDC_CLIENT_ID=
ASLT_OIDC_CLIENT_SECRET=
ASLT_OIDC_CLIENT_SECRET_FILE=
ASLT_OIDC_SCOPES=openid profile email
ASLT_OIDC_ROLE_CLAIM=groups
ASLT_OIDC_DEFAULT_ROLE=viewer
ASLT_OIDC_ALLOWED_SUBJECTS=
ASLT_OIDC_ALLOWED_GROUPS=repeater-scribe-viewers
ASLT_OIDC_OPERATOR_SUBJECTS=
ASLT_OIDC_ADMIN_SUBJECTS=
ASLT_OIDC_OPERATOR_GROUPS=repeater-scribe-operators
ASLT_OIDC_ADMIN_GROUPS=repeater-scribe-admins
ASLT_OIDC_HTTP_TIMEOUT_SECONDS=10
ASLT_REQUEST_BODY_MAX_BYTES=65536
ASLT_REQUEST_RATE_PER_MINUTE=300
ASLT_ANONYMOUS_RATE_PER_MINUTE=60
ASLT_CONTROL_RATE_PER_MINUTE=30
ASLT_SSE_CONNECTIONS_PER_IDENTITY=4
ASLT_RETENTION_DAYS=0
ASLT_AUDIT_RETENTION_DAYS=180
ASLT_RETRY_BACKOFF_SECONDS=5
ASLT_MAX_RETRIES=5
ASLT_AMI_ENABLED=false
ASLT_AMI_HOST=allstarlink3
ASLT_AMI_PORT=5038
ASLT_AMI_USERNAME=admin
# Required when AMI is enabled. There are no deployable credential or node defaults.
ASLT_AMI_SECRET=
ASLT_AMI_SECRET_FILE=
ASLT_AMI_NODE_ID=
ASLT_AMI_TIMEOUT_SECONDS=5
ASLT_AMI_RECONNECT_MAX_SECONDS=60
ASLT_AMI_RECONCILE_SECONDS=5
ASLT_AMI_EVENT_DEBOUNCE_SECONDS=0.15
ASLT_AMI_SSE_HEARTBEAT_SECONDS=15
ASLT_AMI_CONFIRMATION_TIMEOUT_SECONDS=10
ASLT_AMI_CONTROL_ENABLED=false
ASLT_AMI_RAW_FUNCTION_ENABLED=false
# Required for node-control and favorite mutation API routes.
ASLT_API_KEY=
ASLT_API_KEY_FILE=
ASLT_FAVORITE_STATS_ENABLED=true
ASLT_FAVORITE_STATS_BASE_URL=https://stats.allstarlink.org/api/stats
ASLT_FAVORITE_STATS_REQUEST_INTERVAL_SECONDS=3
ASLT_FAVORITE_STATS_TIMEOUT_SECONDS=20
ASLT_FAVORITE_STATS_REFRESH_SECONDS=15
ASLT_FAVORITE_STATS_STALE_SECONDS=300
ASLT_FAVORITE_STATS_RECENT_ACTIVITY_SECONDS=120
ASLT_ALLSTAR_MAX_REQUESTS_PER_MINUTE=30
ASLT_TOPOLOGY_MAX_NODES=200
ASLT_TOPOLOGY_MAX_DEPTH=12
ASLT_TOPOLOGY_REFRESH_SECONDS=900
ASLT_TOPOLOGY_NODE_CACHE_SECONDS=300
ASLT_TOPOLOGY_SSE_HEARTBEAT_SECONDS=15
ASLT_TOPOLOGY_VIEWER_TTL_SECONDS=90

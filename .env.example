ASLT_HOST_ARCHIVE_PATH=./asl-monitor
ASL3_NETWORK_NAME=asl3-docker_default
ASLT_APP_ENV=production
ASLT_APP_NAME=repeater-scribe
ASLT_LOG_LEVEL=INFO
ASLT_DATABASE_URL=sqlite:////data/asl_transcriber.db
ASLT_DATA_DIR=/data
ASLT_TMP_DIR=/tmp
ASLT_SOURCE_TIMEZONE=UTC
ASLT_ARCHIVE_PATHS=/audio
ASLT_CORRELATION_TOLERANCE_SECONDS=30
ASLT_WHISPER_MODEL=tiny.en
ASLT_WHISPER_DEVICE=cpu
ASLT_WHISPER_COMPUTE_TYPE=int8
ASLT_WHISPER_MODEL_DIR=/data/models/whisper
ASLT_WHISPER_LANGUAGE=en
ASLT_WORKER_CONCURRENCY=1
ASLT_ARCHIVE_POLL_SECONDS=5
ASLT_AUTO_PROCESS=true
ASLT_FILE_STABILIZATION_SECONDS=5
ASLT_MIN_DURATION_SECONDS=0.5
ASLT_MAX_DURATION_SECONDS=1800
ASLT_SILENCE_THRESHOLD=-40
ASLT_AUDIO_API_MODE=authenticated
ASLT_AUTH_MODE=off
ASLT_CORS_ORIGINS=http://localhost:8088
ASLT_PUBLIC_BASE_URL=http://localhost:8088
ASLT_RETENTION_DAYS=0
ASLT_RETRY_BACKOFF_SECONDS=5
ASLT_MAX_RETRIES=5
ASLT_READ_ONLY_MODE=true
ASLT_AMI_ENABLED=false
ASLT_AMI_HOST=allstarlink3
ASLT_AMI_PORT=5038
ASLT_AMI_USERNAME=admin
ASLT_AMI_SECRET=change-me
ASLT_AMI_NODE_ID=668390
ASLT_AMI_TIMEOUT_SECONDS=5
ASLT_AMI_RECONNECT_MAX_SECONDS=60
ASLT_AMI_RECONCILE_SECONDS=5
ASLT_AMI_EVENT_DEBOUNCE_SECONDS=0.15
ASLT_AMI_SSE_HEARTBEAT_SECONDS=15
ASLT_AMI_CONFIRMATION_TIMEOUT_SECONDS=10
ASLT_AMI_CONTROL_ENABLED=false
ASLT_API_KEY=change-me
ASLT_FAVORITE_STATS_ENABLED=true
ASLT_FAVORITE_STATS_BASE_URL=http://stats.allstarlink.org/api/stats
ASLT_FAVORITE_STATS_REQUEST_INTERVAL_SECONDS=3
ASLT_FAVORITE_STATS_TIMEOUT_SECONDS=20
ASLT_FAVORITE_STATS_STALE_SECONDS=300
ASLT_FAVORITE_STATS_RECENT_ACTIVITY_SECONDS=120
